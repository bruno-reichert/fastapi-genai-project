<file path="Dockerfile">
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Install high-speed uv package manager natively
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Copy dependency specifications first to leverage Docker layer caching
COPY pyproject.toml uv.lock ./

# Pass --no-cache to prevent saving duplicate installer zips on disk
RUN uv sync --frozen --no-dev --no-install-project --no-cache

# Copy application layers
COPY alembic ./alembic
COPY alembic.ini ./
COPY app ./app
COPY ingest ./ingest
COPY scripts ./scripts

# Perform final sync of your codebase packages with zero caching
RUN uv sync --frozen --no-dev --no-cache

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8000

# Start Uvicorn, mapping the listening port directly to the dynamic $PORT assigned by Railway
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "10000"]
</file>

<file path="pyproject.toml">
[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "document-copilot-backend"
version = "0.1.0"
requires-python = ">=3.12"
dependencies = [
    "alembic==1.18.4",
    "fastapi==0.138.0",
    "httpx==0.28.1",
    "huggingface-hub==1.20.1",
    "openai==2.43.0",
    "pgvector==0.4.2",
    "psycopg[binary]==3.3.4",
    "pydantic==2.13.4",
    "pydantic-ai==1.102.0",
    "pydantic-settings==2.14.2",
    "sqlalchemy==2.0.51",
    "structlog==26.1.0",
    "supabase==2.31.0",
    "uvicorn==0.49.0",
    "groq>=0.9.0",
    "tiktoken>=0.7.0",
    "fastembed==0.8.0",
]

[tool.hatch.build.targets.wheel]
packages = ["app"]

[tool.uv]
add-bounds = "exact"
exclude-newer = "7 days"

# Configure native CPU-only PyTorch index to avoid heavy CUDA GPU runtimes in production
[[tool.uv.index]]
name = "pytorch-cpu"
url = "https://download.pytorch.org/whl/cpu"
explicit = true

[tool.uv.sources]
torch = { index = "pytorch-cpu" }

[dependency-groups]
dev = [
    "ipykernel==7.3.0",
    "pytest==9.1.1",
    "ruff==0.15.18",
]

[tool.ruff.lint.per-file-ignores]
"app/database/models/*.py" = ["F821"]
</file>

<file path="README.md">
# Backend (FastAPI)

Document Copilot API — retrieval, chat orchestration, and grounding.

**Requires:** Python 3.12+, [uv](https://docs.astral.sh/uv/), a Supabase project.

## Setup

```bash
cd backend
uv sync
```

Copy env vars into `backend/.env` (see [supabase-setup](../docs/guides/supabase-setup.md)). Required keys are read by `app/config.py`:

- `SUPABASE_URL`, `SUPABASE_ANON_KEY`, `SUPABASE_SERVICE_ROLE_KEY`
- `DATABASE_URL` (direct Postgres host for Alembic — not the pooler URL)
- `OPENAI_API_KEY`
- `ALLOWED_ORIGINS` (e.g. `http://localhost:5173`)

## Run

```bash
cd backend
uv run uvicorn app.main:app --reload
```

API: `http://localhost:8000` · Health: `GET /health`

Alternative:

```bash
uv run python app/main.py
```

## Dev

```bash
uv run pytest -m "not integration"   # unit tests
uv run ruff check app                  # lint
```

## Migrations

```bash
uv run alembic upgrade head
```

Full Alembic workflow: [backend-setup](../docs/guides/backend-setup.md).
